# ==============================================================================
# MemoryOps Environment Configuration Template
# Copy this file to .env locally. DO NOT commit .env or secrets to Git.
# ==============================================================================

# Express API Server Port
PORT=3000

# Hindsight Cloud or Self-Hosted Memory Engine (Backend only)
# If omitted or empty, MemoryOps operates in explicit simulated fallback mode.
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=memoryops-demo-northstar

# LLM Structured-Output Adapter (Optional)
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Application & Persistence Settings
MEMORYOPS_STATE_FILE=.data/memoryops.json
APP_ENV=development

# Optional Integrations (Disabled by default)
GITHUB_TOKEN=